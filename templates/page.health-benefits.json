    "multirow_jY6FWM": {
      "type": "multirow",
      "blocks": {
        "row_49JpJW": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/imgi_7_pillows-for-allergies.jpg",
            "bigger_margin": false,
            "caption": "",
            "heading": "<em>Traditionally, patients suffering from asthma have been advised to avoid down duvets and pillows in favour of synthetic versions.</em>",
            "text": "<p>However time may have proven this to be false. Medical studies show that synthetic pillows may contain eight times more allergens (from mites) than down- and feather-filled pillows.</p><p>Furthermore, dust mites are killed at around 57°C. Norvegr’s expert washing and cleaning techniques used for all down products, whether on first purchase or sending them for restoration, removes any possibility of mite-related problems. Putting down products in the freezer will also eliminate dust mites.</p>",
            "button_label": "",
            "button_link": "",
            "button_anchor": ""
          }
        }
      },
