    },
    {
      "type": "header",
      "content": "t:sections.linked-banner.settings.header_title.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.linked-banner.settings.title.default",
      "label": "t:sections.linked-banner.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
