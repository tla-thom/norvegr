        },
        {
          "value": "small",
          "label": "t:sections.image-banner.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-banner.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-banner.settings.image_height.options__4.label"
        },
        {
          "value": "xlarge",
          "label": "t:sections.image-banner.settings.image_height.options__5.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-banner.settings.image_height.label"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.mobile_height.options__1.label"
        },
        {
          "value": "50",
          "label": "t:sections.all.mobile_height.options__2.label"
        },
        {
          "value": "60",
          "label": "t:sections.all.mobile_height.options__3.label"
        },
        {
          "value": "70",
          "label": "t:sections.all.mobile_height.options__4.label"
        },
        {
          "value": "80",
          "label": "t:sections.all.mobile_height.options__5.label"
        },
        {
          "value": "90",
          "label": "t:sections.all.mobile_height.options__6.label"
        },
        {
          "value": "100",
          "label": "t:sections.all.mobile_height.options__7.label"
        }
