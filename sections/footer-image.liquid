{{ 'section-footer-image.css' | asset_url | stylesheet_tag }}

{%- liquid
  case section.settings.image_width
    when 'small'
      assign image_width = 150
    when 'large'
      assign image_width = 250
    else
      assign image_width = 200
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="footer-image color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="footer-image__wrapper footer-image__wrapper--{{ section.settings.alignment }}">
      {%- if section.settings.image != blank -%}
        {%- assign image_width_2x = image_width | times: 2 | at_most: 5760 -%}
        {%- assign image_height = image_width | divided_by: section.settings.image.aspect_ratio | round -%}
        <div class="footer-image__media" style="max-width: min(100%, {{ image_width }}px);">
          <img
            srcset="{{ section.settings.image | image_url: width: image_width }}, {{ section.settings.image | image_url: width: image_width_2x }} 2x"
            src="{{ section.settings.image | image_url: width: image_width }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ image_width }}"
            height="{{ image_height }}"
          >
        </div>
      {%- else -%}
        <div class="footer-image__media" style="max-width: min(100%, {{ image_width }}px);">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer image",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        {
          "value": "small",
          "label": "Small (150px)"
        },
        {
          "value": "medium",
          "label": "Medium (200px)"
        },
        {
          "value": "large",
          "label": "Large (250px)"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Footer image"
    }
  ]
}
{% endschema %}
