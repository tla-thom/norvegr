{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_video = section.settings.video
  assign mobile_video = section.settings.video
  assign has_responsive_video = false

  if section.settings.video_mobile != blank
    assign mobile_video = section.settings.video_mobile
    assign has_responsive_video = true
  endif

  assign video_alt = desktop_video.alt | default: section.settings.description
  assign alt = 'sections.video.load_video' | t: description: video_alt | escape
  assign desktop_poster = desktop_video.preview_image | default: section.settings.cover_image
  assign mobile_poster = section.settings.video_mobile.preview_image | default: section.settings.cover_image_mobile | default: desktop_poster
  assign poster = desktop_poster
  assign hero_priority = false
  assign hero_inline = false
  assign poster_fetchpriority = 'auto'
  assign poster_loading = 'lazy'
  assign poster_max_width = 3840
  assign poster_widths = '375, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.index == 1
    assign hero_priority = true
    assign poster_fetchpriority = 'high'
    assign poster_loading = 'eager'
    assign poster_max_width = 1500
    assign poster_widths = '375, 550, 750, 1100, 1500'
  endif

  if hero_priority and section.settings.enable_autoplay and desktop_video != blank
    assign hero_inline = true
  endif

  assign poster_render_width = poster_max_width
  if poster != null and poster.width < poster_render_width
    assign poster_render_width = poster.width
  endif
  if poster != null
    assign poster_render_height = poster_render_width | divided_by: poster.aspect_ratio | round
  endif

  assign video_media_height_mobile = ''
  assign video_media_height_desktop = ''

  unless section.settings.video_height == 'adapt'
    case section.settings.video_height
      when 'small'
        assign video_media_height_mobile = '28rem'
        assign video_media_height_desktop = '42rem'
      when 'medium'
        assign video_media_height_mobile = '34rem'
        assign video_media_height_desktop = '56rem'
      when 'large'
        assign video_media_height_mobile = '39rem'
        assign video_media_height_desktop = '72rem'
      when 'xlarge'
        assign video_media_height_mobile = '45rem'
        assign video_media_height_desktop = '93rem'
    endcase
  endunless
  assign youtube_mute = ''
  assign vimeo_mute = ''
  assign show_video_controls = true

  if section.settings.enable_autoplay
    assign show_video_controls = false
  endif

  if section.settings.enable_mute
    assign youtube_mute = '&mute=1'
    assign vimeo_mute = '&muted=1'
  endif

  if desktop_video != null
    assign ratio_diff = desktop_video.aspect_ratio | minus: poster.aspect_ratio | abs
    if ratio_diff < 0.01 and ratio_diff > 0
      assign fix_ratio = true
    endif
  endif
-%}

{%- capture sizes -%}
  {% if section.settings.full_width -%}
    100vw
  {%- else -%}
    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
    calc(100vw - 10rem), 100vw
  {%- endif %}
{%- endcapture -%}

{%- liquid
  assign video_transparent_button = false
  for scheme in settings.color_schemes
    if scheme.id == section.settings.color_scheme
      if scheme.settings.button.alpha == 0
        assign video_transparent_button = true
      endif
      break
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .video-section__media[data-autoplay='true'] .deferred-media__poster-button {
    display: none;
  }

  {%- if section.settings.video_height == 'adapt' and poster != null -%}
    #shopify-section-{{ section.id }} .video-section__media {
      aspect-ratio: {{ poster.aspect_ratio }};
    }
  {%- elsif video_media_height_desktop != blank -%}
    #shopify-section-{{ section.id }} .video-section__height:not(.video-section__height--adapt) .video-section__media {
      padding-bottom: 0;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .video-section__height:not(.video-section__height--adapt) .video-section__media {
        {%- if section.settings.mobile_height != 'default' -%}
          height: {{ section.settings.mobile_height }}lvh;
          min-height: {{ section.settings.mobile_height }}lvh;
        {%- else -%}
          height: {{ video_media_height_mobile }};
          min-height: {{ video_media_height_mobile }};
        {%- endif -%}
      }
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .video-section__height:not(.video-section__height--adapt) .video-section__media {
        height: {{ video_media_height_desktop }};
        min-height: {{ video_media_height_desktop }};
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div class="video-section-wrapper color-{{ section.settings.color_scheme }}{% if video_transparent_button %} video-section--transparent-button{% endif %}">
  <div class="video-section isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding">
    <div
      class="video-section__height video-section__height--{{ section.settings.video_height }}{% if section.settings.video_height == 'adapt' %} video-section__height--adapt{% endif %}{% if section.settings.mobile_height != 'default' %} video-section__height--mobile-height{% endif %}"
      {% if section.settings.mobile_height != 'default' %}
        style="--banner-mobile-height: {{ section.settings.mobile_height }}lvh;"
      {% endif %}
    >
    <deferred-media
      class="video-section__media deferred-media global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if section.settings.video_height != 'adapt' or fix_ratio or section.settings.mobile_height != 'default' %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll and section.index != 1 %} scroll-trigger animate--slide-in{% endif %}"
      data-media-id="{{ section.id }}"
      {% if has_responsive_video %}
        data-responsive-video="true"
      {% endif %}
      {% if section.settings.enable_autoplay %}
        data-autoplay="true"
      {% endif %}
      {% if hero_inline %}
        data-hero-inline="true"
      {% endif %}
      {% if poster != null and section.settings.video_height == 'adapt' %}
        style="--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
      {% endif %}
    >
      <button
        id="Deferred-Poster-Modal-{{ section.id }}"
        class="video-section__poster media deferred-media__poster media--landscape"
        type="button"
        aria-label="{{ alt }}"
      >
        {%- if poster != null -%}
          {%- if has_responsive_video -%}
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="
                  {%- if mobile_poster.width >= 375 -%}{{ mobile_poster | image_url: width: 375 }} 375w,{%- endif -%}
                  {%- if mobile_poster.width >= 550 -%}{{ mobile_poster | image_url: width: 550 }} 550w,{%- endif -%}
                  {%- if mobile_poster.width >= 750 -%}{{ mobile_poster | image_url: width: 750 }} 750w,{%- endif -%}
                  {{ mobile_poster | image_url: width: 1100 }} 1100w
                "
              >
              {{
                desktop_poster
                | image_url: width: poster_max_width
                | image_tag:
                  sizes: sizes,
                  widths: poster_widths,
                  width: poster_render_width,
                  height: poster_render_height,
                  alt: alt,
                  fetchpriority: poster_fetchpriority,
                  loading: poster_loading
              }}
            </picture>
          {%- else -%}
            {{
              poster
              | image_url: width: poster_max_width
              | image_tag:
                sizes: sizes,
                widths: poster_widths,
                width: poster_render_width,
                height: poster_render_height,
                alt: alt,
                fetchpriority: poster_fetchpriority,
                loading: poster_loading
            }}
          {%- endif -%}
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {%- endif -%}
        <span class="deferred-media__poster-button motion-reduce">
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
      {%- if hero_inline -%}
        <div class="video-section__hero-video{% if has_responsive_video %} small-hide{% endif %}">
          {%- render 'video-section-deferred-source',
            video: desktop_video,
            video_url: section.settings.video_url,
            section: section,
            show_video_controls: show_video_controls,
            youtube_mute: youtube_mute,
            vimeo_mute: vimeo_mute,
            hero_priority: true
          -%}
        </div>
      {%- endif -%}
      {%- if has_responsive_video -%}
        {%- unless hero_inline -%}
          <template data-responsive-video="desktop">
            {%- render 'video-section-deferred-source',
              video: desktop_video,
              video_url: section.settings.video_url,
              section: section,
              show_video_controls: show_video_controls,
              youtube_mute: youtube_mute,
              vimeo_mute: vimeo_mute,
              hero_priority: hero_priority
            -%}
          </template>
        {%- endunless -%}
        <template data-responsive-video="mobile">
          {%- render 'video-section-deferred-source',
            video: mobile_video,
            video_url: section.settings.video_url,
            section: section,
            show_video_controls: show_video_controls,
            youtube_mute: youtube_mute,
            vimeo_mute: vimeo_mute,
            hero_priority: hero_priority
          -%}
        </template>
      {%- elsif hero_inline == false -%}
        <template>
          {%- render 'video-section-deferred-source',
            video: desktop_video,
            video_url: section.settings.video_url,
            section: section,
            show_video_controls: show_video_controls,
            youtube_mute: youtube_mute,
            vimeo_mute: vimeo_mute,
            hero_priority: hero_priority
          -%}
        </template>
      {%- endif -%}
    </deferred-media>
    {%- liquid
      assign show_video_content = false
      if section.settings.heading != blank or section.settings.text != blank
        assign show_video_content = true
      endif
      if section.settings.button_label != blank
        assign show_video_content = true
      endif
      if section.settings.button_label_2 != blank or section.settings.button_label_3 != blank or section.settings.button_label_4 != blank
        assign show_video_content = true
      endif
    -%}
    {%- if show_video_content -%}
      <div class="video-section__content banner__content banner__content--{{ section.settings.content_position }} page-width{% if settings.animations_reveal_on_scroll and section.index != 1 %} scroll-trigger animate--slide-in{% endif %}">
        <div class="video-section__content-inner color-{{ section.settings.color_scheme }}">
          {%- if section.settings.heading != blank -%}
            <h2 class="video-section__heading inline-richtext {{ section.settings.heading_size }}{% if section.settings.use_body_font %} heading--body-font{% endif %}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="video-section__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank
            or section.settings.button_label_2 != blank
            or section.settings.button_label_3 != blank
            or section.settings.button_label_4 != blank
          -%}
            <div class="video-section__buttons">
              {%- if section.settings.button_label != blank -%}
                <a
                  {% if section.settings.button_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.button_link }}"
                  {% endif %}
                  class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- section.settings.button_label | escape -}}
                </a>
              {%- endif -%}
              {%- if section.settings.button_label_2 != blank -%}
                <a
                  {% if section.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- section.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
              {%- if section.settings.button_label_3 != blank -%}
                <a
                  {% if section.settings.button_link_3 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.button_link_3 }}"
                  {% endif %}
                  class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- section.settings.button_label_3 | escape -}}
                </a>
              {%- endif -%}
              {%- if section.settings.button_label_4 != blank -%}
                <a
                  {% if section.settings.button_link_4 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.button_link_4 }}"
                  {% endif %}
                  class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- section.settings.button_label_4 | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.video.settings.heading.default",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "use_body_font",
      "label": "Use Italic",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image-banner.blocks.text.settings.text.label"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 label",
      "info": "t:sections.image-banner.blocks.buttons.settings.button_label_1.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 link"
    },
    {
      "type": "text",
      "id": "button_label_3",
      "label": "Button 3 label"
    },
    {
      "type": "url",
      "id": "button_link_3",
      "label": "Button 3 link"
    },
    {
      "type": "text",
      "id": "button_label_4",
      "label": "Button 4 label"
    },
    {
      "type": "url",
      "id": "button_link_4",
      "label": "Button 4 link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": true,
      "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.video.settings.enable_autoplay.label",
      "info": "t:sections.video.settings.enable_autoplay.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_mute",
      "label": "t:sections.video.settings.enable_mute.label",
      "info": "t:sections.video.settings.enable_mute.info",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video",
      "info": "Optional. Used on screens under 750px. If not set, the desktop video above is used on all devices."
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "image_picker",
      "id": "cover_image_mobile",
      "label": "Mobile cover image",
      "info": "Optional poster shown on mobile before the video loads. Falls back to the video preview or desktop cover image."
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "select",
      "id": "video_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-banner.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-banner.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-banner.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-banner.settings.image_height.options__4.label"
        },
        {
          "value": "xlarge",
          "label": "t:sections.image-banner.settings.image_height.options__5.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-banner.settings.image_height.label"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.mobile_height.options__1.label"
        },
        {
          "value": "50",
          "label": "t:sections.all.mobile_height.options__2.label"
        },
        {
          "value": "60",
          "label": "t:sections.all.mobile_height.options__3.label"
        },
        {
          "value": "70",
          "label": "t:sections.all.mobile_height.options__4.label"
        },
        {
          "value": "80",
          "label": "t:sections.all.mobile_height.options__5.label"
        },
        {
          "value": "90",
          "label": "t:sections.all.mobile_height.options__6.label"
        },
        {
          "value": "100",
          "label": "t:sections.all.mobile_height.options__7.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.mobile_height.label"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__9.label"
        }
      ],
      "default": "bottom-center",
      "label": "t:sections.slideshow.blocks.slide.settings.box_align.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.video.settings.full_width.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.name"
    }
  ]
}
{% endschema %}
