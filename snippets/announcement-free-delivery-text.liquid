{%- comment -%}
  Region-based free delivery announcement text.
  Uses the same regions as country-localization: US, UK, NOR, EUR.

  Accepts:
    - block: {Object} announcement block with threshold settings
{%- endcomment -%}

{%- liquid
  assign current_iso = localization.country.iso_code
  assign current_region = 'EUR'

  if current_iso == 'GB'
    assign current_region = 'UK'
  elsif current_iso == 'US'
    assign current_region = 'US'
  elsif current_iso == 'NO'
    assign current_region = 'NOR'
  endif

  case current_region
    when 'US'
      assign threshold = block.settings.threshold_us | default: 1000
    when 'UK'
      assign threshold = block.settings.threshold_uk | default: 800
    when 'NOR'
      assign threshold = block.settings.threshold_nor | default: 10000
    else
      assign threshold = block.settings.threshold_eur | default: 900
  endcase

  assign threshold_cents = threshold | times: 100
  assign formatted_amount = threshold_cents | money_without_trailing_zeros | strip_html
-%}{{- 'sections.announcements.free_delivery' | t: amount: formatted_amount -}}
