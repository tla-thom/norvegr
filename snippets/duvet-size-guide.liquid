{%- liquid
  assign current_iso = localization.country.iso_code
  assign current_region = 'EUR'
  if current_iso == 'GB'
    assign current_region = 'UK'
  elsif current_iso == 'US'
    assign current_region = 'US'
  elsif current_iso == 'NO'
    assign current_region = 'NOR'
  endif

  assign size_guide_regions = 'US|United States|us,UK|United Kingdom|uk,NOR|Norway|nor-eur,EUR|Europe|nor-eur' | split: ','
-%}

<div class="size-guide">
  {%- for region_config in size_guide_regions -%}
    {%- assign region_parts = region_config | split: '|' -%}
    {%- assign region_code = region_parts[0] -%}
    {%- assign region_label = region_parts[1] -%}
    {%- assign region_table = region_parts[2] -%}
    <div class="product__accordion accordion">
      <details id="SizeGuide-{{ region_code }}"{% if current_region == region_code %} open{% endif %}>
        <summary>
          <div class="summary__title">
            <h3 class="h4 accordion__title inline-richtext">{{ region_label }}</h3>
          </div>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content">
          <table class="tablesorter center">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Size</span></th>
                <th scope="col">Duvets<br>(W x L, cm)</th>
                <th scope="col">Duvets<br>(W x L, Inches)</th>
              </tr>
            </thead>
            <tbody>
              {%- case region_table -%}
                {%- when 'us' -%}
                  <tr><td><em>US Alaskan King</em></td><td>350 x 300</td><td>138 x 118</td></tr>
                  <tr><td><em>US Full</em></td><td>206 x 219</td><td>81 x 86</td></tr>
                  <tr><td><em>US Twin</em></td><td>150 x 229</td><td>59 x 90</td></tr>
                  <tr><td><em>US Queen</em></td><td>229 x 239</td><td>90 x 94</td></tr>
                  <tr><td><em>US XL Twin</em></td><td>180 x 239</td><td>71 x 94</td></tr>
                  <tr><td><em>US California King</em></td><td>260 x 239</td><td>102 x 94</td></tr>
                  <tr><td><em>US King</em></td><td>274 x 239</td><td>108 x 94</td></tr>
                  <tr><td><em>US Imperial King</em></td><td>290 x 239</td><td>114 x 94</td></tr>
                {%- when 'uk' -%}
                  <tr><td><em>UK Single</em></td><td>140 x 200</td><td>55 x 79</td></tr>
                  <tr><td><em>UK Double</em></td><td>200 x 200</td><td>79 x 79</td></tr>
                  <tr><td><em>UK SuperKing</em></td><td>260 x 220</td><td>102 x 87</td></tr>
                  <tr><td><em>UK SuperKing Extra Long</em></td><td>260 x 240</td><td>102 x 94.5</td></tr>
                  <tr><td><em>UK Emperor</em></td><td>290 x 235</td><td>114 x 93</td></tr>
                  <tr><td><em>UK King</em></td><td>230 x 220</td><td>91 x 87</td></tr>
                {%- when 'nor-eur' -%}
                  <tr><td><em>Single</em></td><td>140 x 220</td><td>55 x 87</td></tr>
                  <tr><td><em>King</em></td><td>240 x 220</td><td>95 x 87</td></tr>
              {%- endcase -%}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  {%- endfor -%}
</div>
