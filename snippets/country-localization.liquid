{%- comment -%}
  Renders the country picker for the localization form.
  Grouped regions: UK, US, NOR, EUR (all other available countries).

  Accepts:
    - localPosition: pass in the position in which the form is coming up to create specific IDs
{%- endcomment -%}

{%- liquid
  assign current_iso = localization.country.iso_code
  assign current_region = 'EUR'

  if current_iso == 'GB'
    assign current_region = 'UK'
  elsif current_iso == 'US'
    assign current_region = 'US'
  elsif current_iso == 'NO'
    assign current_region = 'NOR'
  endif

  case current_region
    when 'UK'
      assign current_region_label = 'United Kingdom'
    when 'US'
      assign current_region_label = 'United States'
    when 'NOR'
      assign current_region_label = 'Norway'
    else
      assign current_region_label = 'Europe'
  endcase

  assign show_uk = false
  assign show_us = false
  assign show_nor = false
  assign euro_country_code = ''

  for country in localization.available_countries
    case country.iso_code
      when 'GB'
        assign show_uk = true
      when 'US'
        assign show_us = true
      when 'NO'
        assign show_nor = true
      else
        if euro_country_code == ''
          assign euro_country_code = country.iso_code
        endif
    endcase
  endfor

  assign show_eur = false
  if euro_country_code != ''
    assign show_eur = true
  endif

  if current_region == 'EUR'
    assign eur_country_code = current_iso
  else
    assign eur_country_code = euro_country_code
  endif
-%}

<div class="disclosure">
  <button
    type="button"
    class="disclosure__button localization-form__select localization-selector link link--text caption-large"
    aria-expanded="false"
    aria-controls="{{ localPosition }}-country-results"
    aria-describedby="{{ localPosition }}Label"
  >
    <span class="header-localization__currency">
      <span class="header-localization__currency-code">{{ current_region_label }}</span>
    </span>
    {{ 'icon-caret.svg' | inline_asset_content }}
  </button>
  <div class="disclosure__list-wrapper country-selector country-selector--grouped" hidden>
    <div class="country-filter country-filter--no-padding">
      <button
        class="country-selector__close-button button--small link"
        type="button"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>
    <div
      class="disclosure__list country-selector__list"
      id="{{ localPosition }}-country-results"
    >
      <ul role="list" class="list-unstyled countries">
        {%- if show_us -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large focus-inset"
              href="#"
              {% if current_region == 'US' %}
                aria-current="true"
              {% endif %}
              data-value="US"
              id="{{ localPosition }}-region-us"
            >
              <span
                {% if current_region != 'US' %}
                  class="visibility-hidden"
                {% endif %}
              >
                {{- 'icon-checkmark.svg' | inline_asset_content -}}
              </span>
              <span class="country">United States</span>
            </a>
          </li>
        {%- endif -%}
        {%- if show_uk -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large focus-inset"
              href="#"
              {% if current_region == 'UK' %}
                aria-current="true"
              {% endif %}
              data-value="GB"
              id="{{ localPosition }}-region-uk"
            >
              <span
                {% if current_region != 'UK' %}
                  class="visibility-hidden"
                {% endif %}
              >
                {{- 'icon-checkmark.svg' | inline_asset_content -}}
              </span>
              <span class="country">United Kingdom</span>
            </a>
          </li>
        {%- endif -%}
        {%- if show_nor -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large focus-inset"
              href="#"
              {% if current_region == 'NOR' %}
                aria-current="true"
              {% endif %}
              data-value="NO"
              id="{{ localPosition }}-region-nor"
            >
              <span
                {% if current_region != 'NOR' %}
                  class="visibility-hidden"
                {% endif %}
              >
                {{- 'icon-checkmark.svg' | inline_asset_content -}}
              </span>
              <span class="country">Norway</span>
            </a>
          </li>
        {%- endif -%}
        {%- if show_eur -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large focus-inset"
              href="#"
              {% if current_region == 'EUR' %}
                aria-current="true"
              {% endif %}
              data-value="{{ eur_country_code }}"
              id="{{ localPosition }}-region-eur"
            >
              <span
                {% if current_region != 'EUR' %}
                  class="visibility-hidden"
                {% endif %}
              >
                {{- 'icon-checkmark.svg' | inline_asset_content -}}
              </span>
              <span class="country">Europe</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>
  <div class="country-selector__overlay"></div>
</div>
<input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
