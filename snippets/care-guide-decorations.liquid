{%- comment -%}
  Decorative illustrations for the Care Guide page — desktop only.
  Feather beside Washing, stuff bag beside Storage, pillow beside Restoration.
{%- endcomment -%}

<div class="care-guide-decorations" aria-hidden="true">
  <div class="page-width care-guide-decorations__inner">
    <img
      class="care-guide-decorations__img care-guide-decorations__img--stuff-bag"
      src="{{ 'imgi_8_stuff-bag.png' | file_url }}"
      alt=""
      width="280"
      height="280"
      loading="lazy"
    >
    <img
      class="care-guide-decorations__img care-guide-decorations__img--feather"
      src="{{ 'imgi_7_feather.png' | file_url }}"
      alt=""
      width="240"
      height="240"
      loading="lazy"
    >
    <img
      class="care-guide-decorations__img care-guide-decorations__img--pillow"
      src="{{ 'imgi_9_pillow.png' | file_url }}"
      alt=""
      width="280"
      height="280"
      loading="lazy"
    >
  </div>
</div>
